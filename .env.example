# จำเป็น
GEMINI_API_KEY=your-gemini-api-key

# ไม่จำเป็น — ถ้าไม่ใส่จะใช้ค่าเริ่มต้นในโค้ด (gemini-3.5-flash-lite)
#
# ระวังเรื่องโควตา free tier ต่างกันมากตามรุ่น:
#   gemini-3.5-flash        5 ครั้ง/นาที   20 ครั้ง/วัน   <- รันชุดทดสอบ 80 ครั้งไม่จบใน 1 วัน
#   gemini-3.5-flash-lite   15 ครั้ง/นาที  500 ครั้ง/วัน  <- ค่าเริ่มต้น
#
# ถ้าเปลี่ยนไปใช้รุ่นที่โควตาน้อย ต้องเพิ่ม --delay ตอนรัน benchmark ด้วย
GEMINI_MODEL=gemini-3.5-flash-lite

# ไม่จำเป็น — เพดานความยาวคำตอบ (รวม thinking token ของ Gemini รุ่น 3)
# ตั้งต่ำเกินจะทำให้คำตอบถูกตัดกลางประโยคโดยไม่ error
GEMINI_MAX_OUTPUT_TOKENS=2048

# ไม่จำเป็น — ถ้าไม่ใส่ ระบบจะเก็บประวัติบทสนทนาไว้ในหน่วยความจำแทน
# (รัน benchmark ได้เลยโดยไม่ต้องตั้ง PostgreSQL ก่อน)
# ใช้ Supabase / Neon free tier ก็ได้ ไม่ต้องตั้ง server เอง
DATABASE_URL=postgresql://user:password@host:5432/dbname
